# QueryPilot — copy to .env and fill in values (see PROJECT_BLUEPRINT.md §19)

# Required (Phase 1+)
GROQ_API_KEY=
METADATA_DATABASE_URL=postgresql+asyncpg://querypilot:querypilot@localhost:5435/querypilot_meta
KEK_SECRET=

# Model routing (Phase 1+)
ROUTER_MODEL=openai/gpt-oss-20b
SQL_MODEL=openai/gpt-oss-120b

# Optional limits
DEFAULT_ROW_LIMIT=1000
QUERY_TIMEOUT_SECONDS=5
MAX_SQL_RETRIES=2

# Storage paths
TRACE_BLOB_DIR=./data/traces
FAISS_INDEX_DIR=./data/faiss

# App
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8501
QUERY_CACHE_ENABLED=true
QUERY_CACHE_TTL_SECONDS=3600
SIMPLE_SCHEMA_TABLE_LIMIT=20
RETRIEVAL_TOP_K=12
RETRIEVAL_MAX_TABLES=15
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Streamlit UI only
API_BASE_URL=http://localhost:8000

# Docker Compose defaults (used by compose file)
POSTGRES_USER=querypilot
POSTGRES_PASSWORD=querypilot
METADATA_DB=querypilot_meta
TARGET_DB=chinook
READONLY_PASSWORD=querypilot_readonly_dev
